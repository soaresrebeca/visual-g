Algoritmo "Procedimento_Ex5"

//Criar um procedimento que receba um valor como parâmetro e escreva o dobro dele.

Var

   numero: inteiro

Procedimento dobro(x: inteiro)
//Foi usado parâmetros
Var

Inicio
   escreva("O dobro do número digitado é: ", x*2)
Fimprocedimento

Inicio

   escreva("Digite um número: ")
   leia(numero)

   dobro(numero)

Fimalgoritmo